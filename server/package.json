{
  "name": "postfnb-alba-server",
  "version": "1.0.0",
  "description": "아르바이트 관리 시스템 백엔드 서버",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed-stores": "ts-node prisma/seed-stores.ts",
    "clean-tokens": "ts-node src/scripts/cleanTokens.ts",
    "list-users": "ts-node src/scripts/listUsers.ts",
    "list-stores": "ts-node src/scripts/listStores.ts",
    "reset-admin": "ts-node src/scripts/resetAdminPassword.ts",
    "check-users": "ts-node src/scripts/checkUsers.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "jwt",
    "oauth2"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-kakao": "^1.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-kakao": "^1.0.3",
    "@types/passport-local": "^1.0.38",
    "nodemon": "^3.0.2",
    "prisma": "^6.16.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
